	<parameter name="logo" class="java.awt.Image"/>
	<query language="sql"><![CDATA[SELECT 
    u.id AS idJugador,
    u.nombre AS nombreJugador,
    j.nickname,
    u.fechaRegistro,
    
    -- Total recargado por jugador
    (
        SELECT IFNULL(SUM(r2.monto), 0)
        FROM TA.Cartera c2
        LEFT JOIN TA.Recarga r2 ON c2.idCartera = r2.cartera_IdCartera
        WHERE c2.jugador_idJugador = j.idJugador
    ) AS totalRecargado,

    -- Saldo actual
    ca.saldoActual,

    -- Cantidad de juegos adquiridos por jugador
    (
        SELECT COUNT(DISTINCT ja2.fidJuego)
        FROM TA.Biblioteca b2
        INNER JOIN TA.JuegoAdquirido ja2 ON ja2.fidBiblioteca = b2.idBiblioteca
        WHERE b2.usuario_idUsuario = u.id
    ) AS cantidadJuegosAdquiridos,

    -- Datos del juego
    jg2.idJuego,
    jg2.titulo AS juegoAdquirido,
    
    -- Datos de adquisición
    ja.fechaAdquisicion,
    ja.ultimaSesion,

    -- Calificación del jugador para ese juego (si existe)
    cal.puntaje AS calificacion

FROM 
    TA.Usuario u
INNER JOIN 
    TA.Jugador j ON u.id = j.idJugador
LEFT JOIN 
    TA.Biblioteca b ON b.usuario_idUsuario = u.id
LEFT JOIN 
    TA.JuegoAdquirido ja ON ja.fidBiblioteca = b.idBiblioteca
LEFT JOIN 
    TA.Juego jg2 ON ja.fidJuego = jg2.idJuego
LEFT JOIN 
    TA.Cartera ca ON ca.jugador_idJugador = j.idJugador
LEFT JOIN 
    TA.Calificacion cal ON cal.fidJugador = j.idJugador AND cal.fidJuego = jg2.idJuego

WHERE 
    jg2.idJuego IS NOT NULL
    
GROUP BY idJuego
ORDER BY  calificacion DESC;
]]></query>
