<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://services.pucp.edu.pe" targetNamespace="http://services.pucp.edu.pe" version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="eliminarAdministrador" type="tns:eliminarAdministrador" />
  <xs:element name="eliminarAdministradorResponse" type="tns:eliminarAdministradorResponse" />
  <xs:element name="insertarAdministrador" type="tns:insertarAdministrador" />
  <xs:element name="insertarAdministradorResponse" type="tns:insertarAdministradorResponse" />
  <xs:element name="listarJuegosConMayorCalificacion" type="tns:listarJuegosConMayorCalificacion" />
  <xs:element name="listarJuegosConMayorCalificacionResponse" type="tns:listarJuegosConMayorCalificacionResponse" />
  <xs:element name="listarJuegosQueMasSeVenden" type="tns:listarJuegosQueMasSeVenden" />
  <xs:element name="listarJuegosQueMasSeVendenResponse" type="tns:listarJuegosQueMasSeVendenResponse" />
  <xs:element name="listarTodosAdministradores" type="tns:listarTodosAdministradores" />
  <xs:element name="listarTodosAdministradoresResponse" type="tns:listarTodosAdministradoresResponse" />
  <xs:element name="modificarAdministrador" type="tns:modificarAdministrador" />
  <xs:element name="modificarAdministradorResponse" type="tns:modificarAdministradorResponse" />
  <xs:element name="obtenerAdministradorPorID" type="tns:obtenerAdministradorPorID" />
  <xs:element name="obtenerAdministradorPorIDResponse" type="tns:obtenerAdministradorPorIDResponse" />
  <xs:complexType name="obtenerAdministradorPorID">
    <xs:sequence>
      <xs:element name="idAdministrador" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="obtenerAdministradorPorIDResponse">
    <xs:sequence>
      <xs:element minOccurs="0" name="return" type="tns:administrador" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="administrador">
    <xs:complexContent mixed="false">
      <xs:extension base="tns:usuario">
        <xs:sequence>
          <xs:element name="idAdministrador" type="xs:int" />
          <xs:element minOccurs="0" name="rolAdministrativo" type="xs:string" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="usuario">
    <xs:sequence>
      <xs:element name="activo" type="xs:int" />
      <xs:element minOccurs="0" name="contrasena" type="xs:string" />
      <xs:element minOccurs="0" name="email" type="xs:string" />
      <xs:element minOccurs="0" name="fechaRegistro" type="xs:dateTime" />
      <xs:element minOccurs="0" name="fotoDePerfil" type="xs:string" />
      <xs:element name="idUsuario" type="xs:int" />
      <xs:element minOccurs="0" name="nombre" type="xs:string" />
      <xs:element minOccurs="0" name="rolUsuario" type="tns:rol" />
      <xs:element minOccurs="0" name="telefono" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="listarJuegosConMayorCalificacion">
    <xs:sequence />
  </xs:complexType>
  <xs:complexType name="listarJuegosConMayorCalificacionResponse">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="return" type="tns:juego" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="juego">
    <xs:sequence>
      <xs:element name="activo" type="xs:int" />
      <xs:element name="cantidadCalificaciones" type="xs:int" />
      <xs:element name="cantidadVentas" type="xs:int" />
      <xs:element minOccurs="0" name="desarrollador" type="tns:desarrollador" />
      <xs:element minOccurs="0" name="descripcion" type="xs:string" />
      <xs:element name="espacioDisco" type="xs:double" />
      <xs:element minOccurs="0" name="fechaLanzamiento" type="xs:dateTime" />
      <xs:element minOccurs="0" name="fechaUltimaActualizacion" type="xs:dateTime" />
      <xs:element minOccurs="0" name="genero" type="tns:Genero" />
      <xs:element name="idJuego" type="xs:int" />
      <xs:element minOccurs="0" name="imagen" type="xs:string" />
      <xs:element minOccurs="0" name="modeloNegocio" type="tns:ModeloNegocio" />
      <xs:element name="precio" type="xs:double" />
      <xs:element name="promedioCalificacion" type="xs:double" />
      <xs:element minOccurs="0" name="requisitosMinimos" type="xs:string" />
      <xs:element minOccurs="0" name="requisitosRecomendados" type="xs:string" />
      <xs:element minOccurs="0" name="titulo" type="xs:string" />
      <xs:element name="version" type="xs:double" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="desarrollador">
    <xs:complexContent mixed="false">
      <xs:extension base="tns:usuario">
        <xs:sequence>
          <xs:element name="idDesarrollador" type="xs:int" />
          <xs:element name="ingresoTotal" type="xs:double" />
          <xs:element minOccurs="0" name="numeroCuenta" type="xs:string" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="listarTodosAdministradores">
    <xs:sequence />
  </xs:complexType>
  <xs:complexType name="listarTodosAdministradoresResponse">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="return" type="tns:administrador" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="modificarAdministrador">
    <xs:sequence>
      <xs:element minOccurs="0" name="administrador" type="tns:administrador" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="modificarAdministradorResponse">
    <xs:sequence>
      <xs:element name="return" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="listarJuegosQueMasSeVenden">
    <xs:sequence />
  </xs:complexType>
  <xs:complexType name="listarJuegosQueMasSeVendenResponse">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="return" type="tns:juego" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="insertarAdministrador">
    <xs:sequence>
      <xs:element minOccurs="0" name="administrador" type="tns:administrador" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="insertarAdministradorResponse">
    <xs:sequence>
      <xs:element name="return" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="eliminarAdministrador">
    <xs:sequence>
      <xs:element name="idAdministrador" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="eliminarAdministradorResponse">
    <xs:sequence>
      <xs:element name="return" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="rol">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Jugador" />
      <xs:enumeration value="Administrador" />
      <xs:enumeration value="Desarrollador" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Genero">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Accion" />
      <xs:enumeration value="Rol" />
      <xs:enumeration value="Estrategia" />
      <xs:enumeration value="Shooter" />
      <xs:enumeration value="Simulacion" />
      <xs:enumeration value="Deportes" />
      <xs:enumeration value="Carreras" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ModeloNegocio">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Free_to_play" />
      <xs:enumeration value="Paga" />
      <xs:enumeration value="Suscripcion" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>