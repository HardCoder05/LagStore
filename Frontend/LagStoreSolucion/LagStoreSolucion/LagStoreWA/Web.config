<?xml version="1.0"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <!--
    Para obtener una descripción de los cambios de web.config, vea http://go.microsoft.com/fwlink/?LinkId=235367.

    Los siguientes atributos se pueden establecer en la etiqueta <httpRuntime>.
      <system.Web>
        <httpRuntime targetFramework="4.8.1" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.8.1" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.serviceModel>
  
    <bindings>
      <basicHttpBinding>
        <binding name="JuegoWSPortBinding" />
        <binding name="JuegoAdquiridoWSPortBinding" />
        <binding name="AdministradorWSPortBinding" />
        <binding name="ReporteJugadorWSPortBinding" />
        <binding name="CarroCompraWSPortBinding" />
        <binding name="CarteraWSPortBinding" />
        <binding name="BibliotecaWSPortBinding" />
        <binding name="DesarrolladorWSPortBinding" />
        <binding name="ReporteDesarrolladorWSPortBinding" />
        <binding name="JugadorWSPortBinding" />
        <binding name="UsuarioWSPortBinding" />
        <binding name="ResenaWSPortBinding" />
        <binding name="CalificacionWSPortBinding" />
        <binding name="RecargaWSPortBinding" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:8080/LagStoreWSL/JuegoWS"
        binding="basicHttpBinding" bindingConfiguration="JuegoWSPortBinding"
        contract="ServicesWS.JuegoWS" name="JuegoWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/JuegoAdquiridoWS"
        binding="basicHttpBinding" bindingConfiguration="JuegoAdquiridoWSPortBinding"
        contract="ServicesWS.JuegoAdquiridoWS" name="JuegoAdquiridoWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/AdministradorWS"
        binding="basicHttpBinding" bindingConfiguration="AdministradorWSPortBinding"
        contract="ServicesWS.AdministradorWS" name="AdministradorWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/ReporteJugadorWS"
        binding="basicHttpBinding" bindingConfiguration="ReporteJugadorWSPortBinding"
        contract="ServicesWS.ReporteJugadorWS" name="ReporteJugadorWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/CarroCompraWS"
        binding="basicHttpBinding" bindingConfiguration="CarroCompraWSPortBinding"
        contract="ServicesWS.CarroCompraWS" name="CarroCompraWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/CarteraWS"
        binding="basicHttpBinding" bindingConfiguration="CarteraWSPortBinding"
        contract="ServicesWS.CarteraWS" name="CarteraWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/BibliotecaWS"
        binding="basicHttpBinding" bindingConfiguration="BibliotecaWSPortBinding"
        contract="ServicesWS.BibliotecaWS" name="BibliotecaWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/DesarrolladorWS"
        binding="basicHttpBinding" bindingConfiguration="DesarrolladorWSPortBinding"
        contract="ServicesWS.DesarrolladorWS" name="DesarrolladorWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/ReporteDesarrolladorWS"
        binding="basicHttpBinding" bindingConfiguration="ReporteDesarrolladorWSPortBinding"
        contract="ServicesWS.ReporteDesarrolladorWS" name="ReporteDesarrolladorWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/JugadorWS"
        binding="basicHttpBinding" bindingConfiguration="JugadorWSPortBinding"
        contract="ServicesWS.JugadorWS" name="JugadorWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/UsuarioWS"
        binding="basicHttpBinding" bindingConfiguration="UsuarioWSPortBinding"
        contract="ServicesWS.UsuarioWS" name="UsuarioWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/ResenaWS"
        binding="basicHttpBinding" bindingConfiguration="ResenaWSPortBinding"
        contract="ServicesWS.ResenaWS" name="ResenaWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/CalificacionWS"
        binding="basicHttpBinding" bindingConfiguration="CalificacionWSPortBinding"
        contract="ServicesWS.CalificacionWS" name="CalificacionWSPort" />
      <endpoint address="http://localhost:8080/LagStoreWSL/RecargaWS"
        binding="basicHttpBinding" bindingConfiguration="RecargaWSPortBinding"
        contract="ServicesWS.RecargaWS" name="RecargaWSPort" />
    </client>
  </system.serviceModel>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701;612;618" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008,40000,40008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </compilers>
  </system.codedom>
</configuration>